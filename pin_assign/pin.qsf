# =============================================================================
# traffic_light_top.qsf
# Project  : 4-Way Traffic Light Controller
# Device   : EP4CE6E22C8 — Cyclone IV E, PQFP144
# Clock    : 50MHz @ PIN_23
# Reset    : Active LOW @ PIN_24
# =============================================================================

# -----------------------------------------------------------------------------
# Global Assignments
# -----------------------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY traffic_light_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 21.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "21.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 144
set_global_assignment -name DEVICE_FILTER_PACKAGE "ANY QFP"
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 8
set_global_assignment -name CRC_ERROR_OPEN_DRAIN OFF
set_global_assignment -name USE_CONFIGURATION_DEVICE ON
set_global_assignment -name STRATIX_CONFIGURATION_DEVICE EPCS4
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "AS INPUT TRI-STAGED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS OUTPUT DRIVING GROUND"

# -----------------------------------------------------------------------------
# Source Files
# -----------------------------------------------------------------------------
set_global_assignment -name VERILOG_FILE traffic_light_top.v
set_global_assignment -name VERILOG_FILE direction_sm.v
set_global_assignment -name VERILOG_FILE sm0_coordinator.v
set_global_assignment -name VERILOG_FILE request_decoder.v
set_global_assignment -name VERILOG_FILE config_regs.v
set_global_assignment -name VERILOG_FILE conflict_monitor.v
set_global_assignment -name VERILOG_FILE clk_div.v
set_global_assignment -name VERILOG_FILE dip_controller.v
set_global_assignment -name VERILOG_FILE seg_state.v

# -----------------------------------------------------------------------------
# Timing Constraints
# -----------------------------------------------------------------------------
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SDC_FILE traffic_light_top.sdc

# =============================================================================
# PIN ASSIGNMENTS
# =============================================================================

# -----------------------------------------------------------------------------
# Clock & Reset
# -----------------------------------------------------------------------------
set_location_assignment PIN_23 -to clk
set_location_assignment PIN_24 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# -----------------------------------------------------------------------------
# Config register interface
# cfg_addr[3:0], cfg_data[7:0], cfg_we — assign to free pins
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Config register interface — location auto-assigned by Quartus fitter
# Only IO standard is specified; Quartus will pick valid free pins
# After compilation, check Fitter report to see which pins were assigned,
# then add set_location_assignment if you need them fixed for PCB routing
# -----------------------------------------------------------------------------
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_addr[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_addr[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_addr[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_addr[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_data[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_data[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_data[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_data[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_data[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_data[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_data[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_data[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cfg_we
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to io_mode

# -----------------------------------------------------------------------------
# North outputs: G=PIN_28, Y=PIN_31, R=PIN_33 (straight)
#                G=PIN_30, Y=PIN_32, R=PIN_34 (left)
#                G=PIN_??,           R=PIN_?? (ped — assign when PCB ready)
# -----------------------------------------------------------------------------
set_location_assignment PIN_28 -to n_g_stra
set_location_assignment PIN_31 -to n_y_stra
set_location_assignment PIN_33 -to n_r_stra
set_location_assignment PIN_30 -to n_g_left
set_location_assignment PIN_32 -to n_y_left
set_location_assignment PIN_34 -to n_r_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to n_g_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to n_y_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to n_r_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to n_g_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to n_y_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to n_r_left

# -----------------------------------------------------------------------------
# South outputs: G=PIN_44, Y=PIN_49, R=PIN_51 (straight)
#                G=PIN_46, Y=PIN_50, R=PIN_52 (left)
# -----------------------------------------------------------------------------
set_location_assignment PIN_44 -to s_g_stra
set_location_assignment PIN_49 -to s_y_stra
set_location_assignment PIN_51 -to s_r_stra
set_location_assignment PIN_46 -to s_g_left
set_location_assignment PIN_50 -to s_y_left
set_location_assignment PIN_52 -to s_r_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to s_g_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to s_y_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to s_r_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to s_g_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to s_y_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to s_r_left

# -----------------------------------------------------------------------------
# East outputs: G=PIN_55, Y=PIN_59, R=PIN_64 (straight)
#               G=PIN_58, Y=PIN_65, R=PIN_60 (left — verify against schematic)
# -----------------------------------------------------------------------------
set_location_assignment PIN_55 -to e_g_stra
set_location_assignment PIN_59 -to e_y_stra
set_location_assignment PIN_64 -to e_r_stra
set_location_assignment PIN_58 -to e_g_left
set_location_assignment PIN_65 -to e_y_left
set_location_assignment PIN_60 -to e_r_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to e_g_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to e_y_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to e_r_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to e_g_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to e_y_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to e_r_left

# -----------------------------------------------------------------------------
# West outputs: G=PIN_68, Y=PIN_70, R=PIN_72 (straight)
#               G=PIN_69, Y=PIN_71, R=PIN_73 (left)
# -----------------------------------------------------------------------------
set_location_assignment PIN_68 -to w_g_stra
set_location_assignment PIN_70 -to w_y_stra
set_location_assignment PIN_72 -to w_r_stra
set_location_assignment PIN_69 -to w_g_left
set_location_assignment PIN_71 -to w_y_left
set_location_assignment PIN_73 -to w_r_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to w_g_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to w_y_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to w_r_stra
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to w_g_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to w_y_left
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to w_r_left

# -----------------------------------------------------------------------------
# Pedestrian LEDs: PIN_84=N, PIN_85=S, PIN_86=E, PIN_87=W
# Each direction has r_ped and g_ped
# -----------------------------------------------------------------------------
set_location_assignment PIN_84 -to n_g_ped
set_location_assignment PIN_85 -to s_g_ped
set_location_assignment PIN_86 -to e_g_ped
set_location_assignment PIN_87 -to w_g_ped
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to n_g_ped
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to s_g_ped
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to e_g_ped
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to w_g_ped
# Pedestrian red LEDs — assign when PCB layout is confirmed
# set_location_assignment PIN_XX -to n_r_ped
# set_location_assignment PIN_XX -to s_r_ped
# set_location_assignment PIN_XX -to e_r_ped
# set_location_assignment PIN_XX -to w_r_ped

# -----------------------------------------------------------------------------
# System Fault LED: PIN_144
# -----------------------------------------------------------------------------
set_location_assignment PIN_144 -to system_fault_led
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to system_fault_led

# -----------------------------------------------------------------------------
# Shared inout: 7-seg digit select (output) / DIP switch (input)
# PIN_133=DIG0/N | PIN_135=DIG1/S | PIN_136=DIG2/E | PIN_137=DIG3/W
# -----------------------------------------------------------------------------
set_location_assignment PIN_133 -to dig_dip[0]
set_location_assignment PIN_135 -to dig_dip[1]
set_location_assignment PIN_136 -to dig_dip[2]
set_location_assignment PIN_137 -to dig_dip[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_dip[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_dip[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_dip[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_dip[3]

# -----------------------------------------------------------------------------
# 7-Segment Segment outputs (dedicated pins)
# PIN_128=SEG0 | PIN_121=SEG1 | PIN_125=SEG2 | PIN_129=SEG3
# PIN_132=SEG4 | PIN_126=SEG5 | PIN_124=SEG6 | PIN_127=SEG7
# -----------------------------------------------------------------------------
set_location_assignment PIN_128 -to SVNSEG_SEG[0]
set_location_assignment PIN_121 -to SVNSEG_SEG[1]
set_location_assignment PIN_125 -to SVNSEG_SEG[2]
set_location_assignment PIN_129 -to SVNSEG_SEG[3]
set_location_assignment PIN_132 -to SVNSEG_SEG[4]
set_location_assignment PIN_126 -to SVNSEG_SEG[5]
set_location_assignment PIN_124 -to SVNSEG_SEG[6]
set_location_assignment PIN_127 -to SVNSEG_SEG[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SVNSEG_SEG[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SVNSEG_SEG[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SVNSEG_SEG[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SVNSEG_SEG[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SVNSEG_SEG[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SVNSEG_SEG[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SVNSEG_SEG[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SVNSEG_SEG[7]

# =============================================================================
# END OF FILE
# =============================================================================